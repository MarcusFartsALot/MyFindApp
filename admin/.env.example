SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
ADMIN_PASSWORD_RESET_URL=http://localhost:8081/admin_reset_password.php
# Optional: use a separate random secret instead of the service-role key when
# hashing rate-limit identifiers. Never expose this value to the browser.
ADMIN_RECOVERY_RATE_LIMIT_SECRET=
MAIL_FROM=no-reply@example.com
APP_NAME=MyFind
SESSION_NAME=myfind_admin
# Optional existing writable directory; defaults to the operating-system temp
# directory so PHP recovery sessions survive the Supabase callback.
SESSION_SAVE_PATH=
